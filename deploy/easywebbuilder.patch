 logger = logging.getLogger("gateway.run")
 
 
+def _prefix_supabase_lookup(event: MessageEvent, message_text: str) -> str:
+    """Put the Supabase users-table lookup on this turn's model-facing message.
+
+    The gateway already searched public.users; if the sender is missing, the agent
+    must start registration even when the Telegram session has long unrelated history.
+    """
+    meta = getattr(event, "metadata", None)
+    sender = meta.get("supabase_sender") if isinstance(meta, dict) else None
+    if not isinstance(sender, dict) or not sender.get("sender_id"):
+        return message_text
+    sender_id = sender["sender_id"]
+    platform = sender.get("platform") or "telegram"
+    if sender.get("registered"):
+        prefix = (
+            f"[easyWebBuilder lookup] Searched Supabase users for {platform} "
+            f"sender_id={sender_id}: FOUND. Skip registration and help with their site. "
+            "To change prices, add services, edit working hours, FAQ, site text, or theme, "
+            f"call update_website_data with identifier={sender_id}, platform={platform}, "
+            "and site_data_update. Put theme on the root (clinical, luxury, zen, corporate, default). "
+            "Content goes in site_data_update.sections (hero, services, working_hours, faq).\n\n"
+        )
+    else:
+        prefix = (
+            f"[easyWebBuilder lookup] Searched Supabase table users for {platform} "
+            f"sender_id={sender_id}: NOT FOUND. This is a new user. Ignore unrelated prior "
+            f"chat history. Greet them in their language, then ask for business/website name, "
+            f"owner full name, and type of activity. Suggest a subdomain from the business name. "
+            f"When you have those, call check_and_register_user with sender_id={sender_id}, "
+            f"platform={platform}, business_name, owner_name, and subdomain.\n\n"
+        )
+    return prefix + (message_text or "")
+
+
