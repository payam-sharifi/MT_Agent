 logger = logging.getLogger("gateway.run")
 
 
+def _prefix_supabase_lookup(event: MessageEvent, message_text: str) -> str:
+    """Put the Supabase account lookup on this turn's model-facing message.
+
+    attach_inbound_sender_context already created a missing user and website.
+    Prefer the prefix stored on the event so the tool layer owns the wording.
+    """
+    meta = getattr(event, "metadata", None)
+    sender = meta.get("supabase_sender") if isinstance(meta, dict) else None
+    if not isinstance(sender, dict) or not sender.get("sender_id"):
+        return message_text
+    custom = sender.get("lookup_prefix")
+    if isinstance(custom, str) and custom.strip():
+        prefix = custom if custom.endswith("\n") else custom + "\n\n"
+        return prefix + (message_text or "")
+    sender_id = sender["sender_id"]
+    platform = sender.get("platform") or "telegram"
+    preview = sender.get("preview_url") or ""
+    prefix = (
+        f"[easyWebBuilder lookup] platform={platform} sender_id={sender_id}. "
+        f"Live preview: {preview}. Edit only the active website. "
+        "After every change, send https://[slug].easywebbuilder.de and ask the user to confirm.\n\n"
+    )
+    return prefix + (message_text or "")
+
+
 class GatewayInboundMixin:
